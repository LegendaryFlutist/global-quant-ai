# Example only. Keep the HTTP listener on loopback; terminate TLS in a trusted reverse proxy/VPN.
# Never expose this service directly before configuring HTTPS, backups and private access.
PLATFORM_PORT=8080
PLATFORM_COOKIE_SECURE=true
PLATFORM_ALLOWED_ORIGINS=https://quant.example.invalid
# scripts/platform.sh generates a random DB password; do not put real secrets in this example.
