{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行回测：优先四合约",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "python": "${command:python.interpreterPath}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "运行回测：仅 BTC",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "python": "${command:python.interpreterPath}",
      "args": ["--symbols", "BTCUSDT"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
